# Base de données PostgreSQL principale (Docker ou locale)
DATABASE_URL="postgresql://localimpact:localimpact@localhost:5432/localimpact?schema=public"

# Base de données PostgreSQL isolée pour les tests d'intégration
DATABASE_URL_TEST="postgresql://localimpact:localimpact@localhost:5432/localimpact_test?schema=public"

# Secret de signature des cookies de session (à définir en production)
SESSION_SECRET=

# Mettre à "true" uniquement derrière HTTPS ; "false" pour Docker HTTP local
COOKIE_SECURE="false"

# Répertoire de stockage persistant des photos uploadées
UPLOAD_DIR="/app/uploads"
